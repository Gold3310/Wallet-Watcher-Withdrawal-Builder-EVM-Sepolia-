{
  "name": "collect-group-assignment",
  "version": "1.0.0",
  "description": "Wallet Watcher and Withdrawal Builder for Ethereum Sepolia",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:events": "tsx scripts/verify-events.ts",
    "wallet:derive": "tsx scripts/derive-wallet.ts",
    "token:compile": "tsx scripts/compile-token.ts",
    "token:deploy": "tsx scripts/deploy-token.ts",
    "token:mint": "tsx scripts/mint-token.ts"
  },
  "author": "Mumtaz503",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "solc": "^0.8.28",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
