# Sepolia RPC endpoint (Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<INFURA_API_KEY>

# Testnet-only mnemonic. Never use mainnet keys.
WALLET_MNEMONIC=your twelve word testnet mnemonic here

# Number of wallets to derive (1-20)
WALLET_COUNT=5

# Balance polling interval in milliseconds (default: 120000 = 2 minutes)
POLL_INTERVAL_MS=120000

# HTTP port
PORT=3000

# SQLite database file path
DATABASE_PATH=./data/wallets.db
