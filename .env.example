# Chain to run against: sepolia (default) or mainnet
CHAIN=sepolia

# Sepolia RPC endpoint (Alchemy, Infura, or public RPC). Required when CHAIN=sepolia.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<INFURA_API_KEY>

# Mainnet RPC endpoint. Required when CHAIN=mainnet.
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/<INFURA_API_KEY>

# Explicit opt-in to running against mainnet (real funds). Required when CHAIN=mainnet.
# MAINNET_ENABLED=true

# Ceiling on any single mainnet transaction, in wei (default: 100000000000000000 = 0.1 ETH).
# Testnets are uncapped.
# MAINNET_MAX_TX_VALUE_WEI=100000000000000000

# Longest mainnet permission grant, in seconds (default: 86400 = 24h).
# MAINNET_MAX_GRANT_EXPIRY_SECONDS=86400

# Allow mainnet grants with no spending-cap policy (default: false).
# MAINNET_ALLOW_UNBOUNDED_GRANTS=false

# Withdrawal destinations, comma-separated. When set, withdrawals and permission
# redemptions to any other address are rejected before signing. Empty = unrestricted.
#
# The address below is the withdrawable owner: the destination funds may be sent to.
WITHDRAWAL_ALLOWLIST=0x2ddFBecA5B62f310A5F8edEFB4fC026A99B979CE

# Velocity limit per wallet: max outflow (wei) within WITHDRAWAL_WINDOW_SECONDS.
# Unset = no velocity limit.
# WITHDRAWAL_MAX_PER_WINDOW_WEI=500000000000000000

# Velocity window in seconds (default: 86400).
# WITHDRAWAL_WINDOW_SECONDS=86400

# Bearer tokens as "<id>:<secret>" pairs. Required on mainnet; when set, every
# request except GET /health must send "Authorization: Bearer <secret>", and the
# id is recorded against each outflow.
# API_TOKENS=ops:<secret>

# Mnemonic for wallet derivation. Derived addresses are identical on every chain.
WALLET_MNEMONIC=your twelve word testnet mnemonic here

# Number of wallets to derive (1-20)
WALLET_COUNT=5

# Balance polling interval in milliseconds (default: 120000 = 2 minutes)
POLL_INTERVAL_MS=120000

# HTTP port
PORT=3000

# SQLite database file path. Defaults to ./data/wallets.db on testnets and
# ./data/mainnet-wallets.db on mainnet. A database is pinned to the chain it was
# created on — use a different path per chain.
DATABASE_PATH=./data/wallets.db

# Longest permission grant accepted by POST /permissions, in seconds (default: 30 days)
PERMISSIONS_MAX_EXPIRY_SECONDS=2592000

# Grant expiry used when a request omits `expiry`, in seconds (default: 1 hour)
PERMISSIONS_DEFAULT_EXPIRY_SECONDS=3600
